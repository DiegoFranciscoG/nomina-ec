# Copia este archivo a .env y completa los valores. .env NUNCA se sube a GitHub.
# Genera secretos con:  openssl rand -base64 48

# --- Base de datos (local: contenedor "db"; producción: Neon)
DB_URL=jdbc:postgresql://localhost:5432/nomina
DB_USER=nomina
DB_PASSWORD=

# --- Seguridad
JWT_EXPIRATION_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
JWT_SECRET=
# ^ mínimo 32 caracteres aleatorios (HS256, 256 bits)

# --- Usuarios iniciales (se crean en el primer arranque; ADMIN_PASSWORD mínimo 12 caracteres)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Usuario de demostración con rol PAYROLL (opcional: deja vacío para no crearlo)
DEMO_USERNAME=demo
DEMO_PASSWORD=

# --- Datos ficticios de demostración (empleados, periodos del año en curso)
DEMO_DATA=true
COMPANY_NAME=Empresa Demo S.A.
